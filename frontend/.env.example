# Copy to .env.local for local dev. NEVER commit real keys.
# Vercel: set these in Dashboard > Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Browser key MUST be the publishable key (sb_publishable_...).
# NEVER put sb_secret_* or service_role here — browsers reject secret keys
# with 401 "forbidden use of secret api key".
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Production backend (Render litmus-bmdv). Local fallback is http://127.0.0.1:8000.
NEXT_PUBLIC_API_URL=https://litmus-bmdv.onrender.com
